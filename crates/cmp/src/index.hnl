--- cmp.eq -- test whether two values are deeply equal.
--- cmp.ne -- test whether two values are not equal.
--- cmp.lt -- test whether the first value is less than the second.
--- cmp.le -- test whether the first value is less than or equal to the second.
--- cmp.gt -- test whether the first value is greater than the second.
--- cmp.ge -- test whether the first value is greater than or equal to the second.
--- cmp.compare -- compare two values, returning -1, 0, or 1.
--- cmp.min -- return the minimum of all arguments.
--- cmp.max -- return the maximum of all arguments.
--- cmp.clamp -- clamp a value between a lower and upper bound.
--- cmp.between -- test whether a value is between two bounds (exclusive).
--- cmp.in_range -- test whether a value is within a range (alias of between).
--- cmp.is_sorted -- test whether an array is sorted in ascending order.
--- cmp.is_sorted_desc -- test whether an array is sorted in descending order.
--- cmp.sort -- sort an array in ascending order.
--- cmp.sort_desc -- sort an array in descending order.
--- cmp.sort_by -- sort an array by a key function in ascending order.
--- cmp.sort_by_desc -- sort an array by a key function in descending order.
--- cmp.min_by -- find the minimum element by a key function.
--- cmp.max_by -- find the maximum element by a key function.
cap "cmp.eq"
cap "cmp.ne"
cap "cmp.lt"
cap "cmp.le"
cap "cmp.gt"
cap "cmp.ge"
cap "cmp.compare"
cap "cmp.min"
cap "cmp.max"
cap "cmp.clamp"
cap "cmp.between"
cap "cmp.in_range"
cap "cmp.is_sorted"
cap "cmp.is_sorted_desc"
cap "cmp.sort"
cap "cmp.sort_desc"
cap "cmp.sort_by"
cap "cmp.sort_by_desc"
cap "cmp.min_by"
cap "cmp.max_by"
op "cmp.eq" : (Value, Value) -> Bool
  guarantee: True
op "cmp.ne" : (Value, Value) -> Bool
  guarantee: True
op "cmp.lt" : (Value, Value) -> Bool
  guarantee: True
op "cmp.le" : (Value, Value) -> Bool
  guarantee: True
op "cmp.gt" : (Value, Value) -> Bool
  guarantee: True
op "cmp.ge" : (Value, Value) -> Bool
  guarantee: True
op "cmp.compare" : (Value, Value) -> Number
  guarantee: Le(output, 1)
op "cmp.min" : Value... -> Value
  guarantee: True
op "cmp.max" : Value... -> Value
  guarantee: True
op "cmp.clamp" : (Value, Value, Value) -> Value
  guarantee: True
op "cmp.between" : (Value, Value, Value) -> Bool
  guarantee: True
op "cmp.in_range" : (Value, Value, Value) -> Bool
  guarantee: True
op "cmp.is_sorted" : Array -> Bool
  guarantee: True
op "cmp.is_sorted_desc" : Array -> Bool
  guarantee: True
op "cmp.sort" : Array -> Array
  guarantee: True
op "cmp.sort_desc" : Array -> Array
  guarantee: True
op "cmp.sort_by" : (Function, Array) -> Array
  guarantee: True
op "cmp.sort_by_desc" : (Function, Array) -> Array
  guarantee: True
op "cmp.min_by" : (Function, Array) -> Value
  guarantee: True
op "cmp.max_by" : (Function, Array) -> Value
  guarantee: True

handle "cmp.eq" with rust_cmp_eq
handle "cmp.ne" with rust_cmp_ne
handle "cmp.lt" with rust_cmp_lt
handle "cmp.le" with rust_cmp_le
handle "cmp.gt" with rust_cmp_gt
handle "cmp.ge" with rust_cmp_ge
handle "cmp.compare" with rust_cmp_compare
handle "cmp.min" with rust_cmp_min
handle "cmp.max" with rust_cmp_max
handle "cmp.clamp" with rust_cmp_clamp
handle "cmp.between" with rust_cmp_between
handle "cmp.in_range" with rust_cmp_in_range
handle "cmp.is_sorted" with rust_cmp_is_sorted
handle "cmp.is_sorted_desc" with rust_cmp_is_sorted_desc
handle "cmp.sort" with rust_cmp_sort
handle "cmp.sort_desc" with rust_cmp_sort_desc
handle "cmp.sort_by" with rust_cmp_sort_by
handle "cmp.sort_by_desc" with rust_cmp_sort_by_desc
handle "cmp.min_by" with rust_cmp_min_by
handle "cmp.max_by" with rust_cmp_max_by
