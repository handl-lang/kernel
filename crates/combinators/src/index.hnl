  guarantee: True
op "combinators.constantly" : Value -> Value
  guarantee: True
op "combinators.flip" : Value -> Value
  guarantee: True
op "combinators.partial" : (Value * Value) -> Value
  guarantee: True
op "combinators.when" : (Value * Value * Value) -> Value
  guarantee: True
