--- mood -- mood (mode-of-data) operations for the handl runtime.
---
--- Single source of truth for the `mood` stdlib interface: 6 functions
--- covering projection, intersection, normalization, potential extraction,
--- complement, and conditional fallback. The Rust bridge in
--- `plugin-lib-utils` loads this file via `include_str!`, parses the `cap`
--- declarations for the plugin capability surface, and registers the Rust
--- handls (handlers) in an `OpRegistry` that dispatches each `op` to its
--- native Rust impl.
---
--- All 6 functions are FFI atoms (they use `as_kind`, `project`,
--- `complement`, `matches`, `ok_result`, and `err_result` from
--- `crate::shared` and cannot be expressed as pure handl arrows without
--- losing the exact error messages the tests rely on). The `op`/`handl`
--- declaration form (ADR-0077 Phase 2) declares the interface; the Rust
--- `Function` impls in `ops.rs` provide the logic.
---
--- ## Capability declarations (ADR-0077 Phase 4)
--- mood.ind -- strict projection: extract the matching component or error.
--- mood.int -- intersection: test whether a value matches a kind.
--- mood.norm -- normalized projection: wrap the result in an ok/err record.
--- mood.pot -- potential extraction: extract the matching component or null.
--- mood.neg -- complement: extract the non-matching component or null.
--- mood.cnd -- conditional: extract the matching component or return a default.
cap "mood.ind"
cap "mood.int"
cap "mood.norm"
cap "mood.pot"
cap "mood.neg"
cap "mood.cnd"
op "mood.ind" : (Value * Value) -> Value
  guarantee: True
op "mood.int" : (Value * Value) -> Bool
  guarantee: True
op "mood.norm" : (Value * Value) -> Value
  guarantee: True
op "mood.pot" : (Value * Value) -> Value
  guarantee: True
op "mood.neg" : (Value * Value) -> Value
  guarantee: True
op "mood.cnd" : (Value * Value * Value) -> Value
  guarantee: True
handle "mood.ind" with rust_mood_ind
handle "mood.int" with rust_mood_int
handle "mood.norm" with rust_mood_norm
handle "mood.pot" with rust_mood_pot
handle "mood.neg" with rust_mood_neg
handle "mood.cnd" with rust_mood_cnd
