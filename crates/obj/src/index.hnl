--- obj -- record introspection primitives (gap #3).
---
--- `obj.keys`, `obj.values`, and `obj.entries` enumerate the fields of a
--- Handl object, preserving the iteration order of the underlying
--- `serde_json::Map`. On non-object input they raise `TypeMismatch`.

cap "obj.keys"
cap "obj.values"
cap "obj.entries"

op "obj.keys" : Object -> Array
  guarantee: IsArray(output)
op "obj.values" : Object -> Array
  guarantee: IsArray(output)
op "obj.entries" : Object -> Array
  guarantee: IsArray(output)
